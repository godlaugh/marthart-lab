        "endEaseEnabled": true,
        "fadeInStatorsOnStart": true,
        "fadeOutStatorsOnFinish": false,
        "layers": [
          {
            "id": "guide-spirograph-rose",
            "name": "指南 · Rose Curve",
            "statorRadius": 150,
            "rotors": [
