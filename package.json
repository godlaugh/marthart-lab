{
  "name": "mathart-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "server": "node server/index.mjs",
    "desktop:dev": "npm run build && node scripts/desktop-start.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:build:v2": "node scripts/desktop-build.mjs --preview-v2",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:test": "node --test desktop/desktop.verify.mjs desktop/native-backend.test.mjs",
    "dev:v2": "vite --host 127.0.0.1 --port 5179 --mode preview-v2",
    "build:v2": "tsc --noEmit && vite build --mode preview-v2 --outDir dist-v2",
    "preview:v2": "vite preview --host 127.0.0.1 --port 5179 --outDir dist-v2"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "lucide-react": "^0.468.0",
    "mathjs": "^14.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.7.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.16.0"
}
